# ---- 依赖 / 缓存 ----
__pycache__/
*.pyc
node_modules
.pnpm-store/

# ---- 构建产物 ----
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.vite/

# ---- 本地配置与缓存 ----
*.local
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 编辑器 ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- 取数中间产物（可由 tools/fetch-data.sh 重新下载）----
tools/raw/
src/assets/**/_*-portrait-full.png

# ---- 图片素材：模板仓库不放图，由角色仓库各自落盘（.gitattributes 里的 LFS 规则已备好）----
# 想给本页配图：python3 tools/fetch-assets.py --id <角色ID> 后 git add src/assets 即可
src/assets/char/*
src/assets/icons/*
src/assets/items/*
!src/assets/*/.gitkeep
